# Telegram-Bot-Token von @BotFather. Niemals ins Repo committen!
BOT_TOKEN=

# "polling" für lokale Entwicklung, "webhook" für den Server
BOT_MODE=polling

# Nur für BOT_MODE=webhook: öffentliche HTTPS-Adresse, unter der der Container erreichbar ist
# (z. B. hinter einem Reverse Proxy), und ein zufälliges Geheimnis (z. B. `openssl rand -hex 32`)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Mini App (optional): HTTPS-Adresse der Seite /app. Leer = bei BOT_MODE=webhook automatisch WEBHOOK_URL + /app.
# Der Bot setzt dann den Menüknopf „Botzeps“ im privaten Chat.
MINIAPP_URL=

# Port des eingebauten HTTP-Servers (Webhook + /health)
PORT=3000

# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/botzeps.db

# Zeitzone für Wochenberichte und Erinnerungen
TZ=Europe/Berlin

# debug | info | warn | error
LOG_LEVEL=info

# Demo-Modus: Fake-Teilnehmer und Zeitsprünge (/demo, /vorspulen). Nur für einen eigenen Test-Bot!
DEMO_MODUS=0
# Für `docker compose --profile demo`: Token des Test-Bots und optional die HTTPS-Adresse seiner Mini App
DEMO_BOT_TOKEN=
DEMO_MINIAPP_URL=
